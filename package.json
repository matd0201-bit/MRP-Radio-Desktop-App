{
  "name": "mishap-rp-radio-desktop",
  "version": "4.0.0",
  "private": true,
  "description": "Version bureau portable de MISHAP RP RADIO",
  "main": "main.js",
  "author": "MISHAP RP RADIO",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "fr.mishaprp.radio",
    "productName": "MISHAP RP RADIO",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "assets/mishap-radio.png",
      "package.json",
      "node_modules/uiohook-napi/**/*",
      "!node_modules/uiohook-napi/**/*.md",
      "!node_modules/uiohook-napi/**/*.map"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**/*.node"
    ],
    "win": {
      "icon": "assets/mishap-radio.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "MISHAP-RP-RADIO-${version}-Portable.${ext}",
      "unpackDirName": "MISHAP-RP-RADIO"
    }
  }
}
